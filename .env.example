# PostgreSQL least-privileged runtime role (RLS must not be bypassed)
DATABASE_URL=postgresql://fixflow_app:password@localhost:5432/fixflow
# Firebase browser configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Admin service account fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Cloudinary (secret is server-only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Paystack (public key browser-safe; secret server-only)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=fixflow_session
CSRF_SECRET=generate-at-least-32-random-bytes
NODE_ENV=development
